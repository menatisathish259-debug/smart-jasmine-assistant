# Environment Configuration for Smart Jasmine Farming Assistant
# Copy this file to .env and fill in your custom values

# App Environment (development / production)
APP_ENV=development
DEBUG=True

# Weather API Settings (Module G - Phase 10)
# Example: OpenWeatherMap or WeatherAPI free tier key
WEATHER_API_KEY=
WEATHER_CITY=Madurai
WEATHER_LAT=9.9252
WEATHER_LON=78.1198

# Database Path Override (Optional, defaults to data/db/jasmine_farm.db)
DB_PATH=
